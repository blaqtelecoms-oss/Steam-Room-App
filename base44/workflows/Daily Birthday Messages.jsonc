{
  "name": "Daily Birthday Messages",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 8 * * *",
      "one_time_date": null,
      "timezone": "Africa/Johannesburg",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_birthday_messages",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_birthdays": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "SendBirthdayMessages"
          },
          "then": "end",
          "x-base44": {
            "title": "Send birthday messages",
            "description": "Email members with today's birthday"
          }
        }
      }
    ]
  },
  "description": "Emails every member whose birthday (parsed from their RSA ID number on file) is today."
}