{
  "name": "Trainer",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "specialty": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "image_fit": {
      "type": "string",
      "enum": [
        "cover",
        "contain"
      ],
      "default": "cover"
    },
    "image_position": {
      "type": "string",
      "enum": [
        "top",
        "center",
        "bottom"
      ],
      "default": "top"
    },
    "bio": {
      "type": "string"
    },
    "certifications": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "experience": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "default": 5
    },
    "order": {
      "type": "number",
      "default": 0
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "sr_code": {
      "type": "string",
      "description": "Trainer's unique SR code used as login password"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}