{
  "name": "Employee",
  "type": "object",
  "properties": {
    "emp_number": {
      "type": "string",
      "description": "Employee number e.g. EMP0001"
    },
    "email": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "user_id": {
      "type": "string",
      "description": "Linked app user ID (set after invite acceptance)"
    },
    "member_id": {
      "type": "string",
      "description": "Linked Member record for gym membership"
    },
    "permitted_tabs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Admin tabs this employee can access. Empty = personal info only."
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "invited_date": {
      "type": "string",
      "format": "date"
    },
    "accepted_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "emp_number",
    "email"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}