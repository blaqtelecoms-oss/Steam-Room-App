{
  "name": "Booking",
  "type": "object",
  "properties": {
    "member_id": {
      "type": "string"
    },
    "member_name": {
      "type": "string"
    },
    "member_phone": {
      "type": "string"
    },
    "trainer_id": {
      "type": "string"
    },
    "trainer_name": {
      "type": "string"
    },
    "session_type": {
      "type": "string",
      "enum": [
        "One-on-One",
        "Two-Person"
      ],
      "default": "One-on-One"
    },
    "price": {
      "type": "number"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "time": {
      "type": "string"
    },
    "second_participant": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "completed",
        "cancelled"
      ],
      "default": "pending"
    },
    "notes": {
      "type": "string"
    },
    "trainer_paid": {
      "type": "boolean",
      "default": false,
      "description": "Whether the admin has paid the trainer for this session"
    },
    "trainer_paid_date": {
      "type": "string",
      "format": "date",
      "description": "Date the trainer was paid for this session"
    }
  },
  "required": [
    "member_name",
    "trainer_name",
    "session_type",
    "date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}