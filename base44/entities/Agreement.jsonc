{
  "name": "Agreement",
  "type": "object",
  "properties": {
    "member_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "terms",
        "members_agreement",
        "physical_readiness"
      ],
      "default": "terms"
    },
    "agreed": {
      "type": "boolean",
      "default": false
    },
    "signature": {
      "type": "string"
    },
    "signed_date": {
      "type": "string",
      "format": "date"
    },
    "answers": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "member_id",
    "type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}