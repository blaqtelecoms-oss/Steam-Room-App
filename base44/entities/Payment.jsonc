{
  "name": "Payment",
  "type": "object",
  "properties": {
    "member_id": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "paid",
        "pending",
        "overdue"
      ],
      "default": "pending"
    },
    "description": {
      "type": "string"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "method": {
      "type": "string"
    },
    "invoice_no": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "membership",
        "joining_fee",
        "merchandise",
        "credit"
      ],
      "default": "membership"
    }
  },
  "required": [
    "amount",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}